<html>
	<head>
		<meta charset='utf-8' />
		<meta http-equiv='X-UA-Compatible' content='IE=edge' />
		<meta name='ad.size' content='width={{width}},height={{height}}' />
		<title>ING Banners: {{width}}x{{height}}</title>
		<link rel='stylesheet' href='src/style.css' />
		{{#if template}}
			<link rel='stylesheet' href='src/{{template}}.css' />
		{{else}}
			<link rel='stylesheet' href='src/wide.css' />
		{{/if}}

		<!-- clickTag url-->
		<script type='text/javascript'>
			var clickTag = '{{url}}';
		</script>
	</head>

	<body>
		<div id='ad' style='width: {{width}}px; height: {{height}}px'>
			<div
				id='banner'
				data-width='{{width}}'
				data-height='{{height}}'
				style='width: {{width}}px; height: {{height}}px'
			>
				<div class='slide image'>
					<img src='src/image_scaled.jpg' alt='' />
				</div>
				<div class='slide content'>
					<div class='logo'>
						<img class='logo-white' src='src/id.png' alt='' />
					</div>
					<div class='text'>
						{{#each headline}}
							<span>{{this}}</span>
						{{/each}}
					</div>
					<div class='button'>{{button_text}}</div>
				</div>

				<div class='outerBorder'></div>

				<!-- Fallback & clickTag -->
				<a
					href='javascript:void(0);'
					onClick='window.open(window.clickTag)'
					class='clicktag'
				>
					<!--[if lte IE 8]>
						<img src="fallback.jpg" alt="" class="fallback" />
					<![endif]-->
				</a>
			</div>
		</div>
		<script
			src='https://s0.2mdn.net/ads/studio/cached_libs/gsap_3.2.4_min.js'
		></script>
		<script
			src='https://cdnjs.cloudflare.com/ajax/libs/jquery/3.4.1/jquery.min.js'
		></script>

		{{#if template}}
			<script src='src/{{template}}.js'></script>
		{{else}}
			<script src='src/wide.js'></script>
		{{/if}}
	</body>
</html>